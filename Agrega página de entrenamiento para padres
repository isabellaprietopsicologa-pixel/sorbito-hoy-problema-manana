<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Entrenamiento para Padres · Consumo Adolescente · Colombia</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --verde: #1A7A4A;
    --verde-claro: #E8F5EE;
    --verde-medio: #2ECC71;
    --amarillo: #F39C12;
    --rojo: #E74C3C;
    --azul: #2C3E7A;
    --crema: #FDF9F3;
    --cafe: #5D3A1A;
    --gris: #6B7280;
    --blanco: #FFFFFF;
    --sombra: 0 4px 24px rgba(0,0,0,0.08);
    --sombra-fuerte: 0 8px 40px rgba(0,0,0,0.15);
    --radio: 16px;
    --radio-sm: 8px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--crema);
    color: #1a1a2e;
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    background: linear-gradient(135deg, #1a2744 0%, #2C3E7A 60%, #1A7A4A 100%);
    color: white;
    text-align: center;
    padding: 80px 24px 60px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .badge-top {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    padding: 6px 18px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 600;
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 20px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero h1 span { color: #7EE8A2; }

  .hero p {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.8);
    max-width: 520px;
    margin: 0 auto 36px;
    line-height: 1.7;
  }

  .nivel-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50px;
    padding: 8px 20px;
    font-size: 0.9rem;
    margin: 0 6px 12px;
    transition: all 0.2s;
  }

  .nivel-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #7EE8A2;
  }

  .btn-start {
    display: inline-block;
    background: white;
    color: var(--azul);
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 16px 40px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    margin-top: 32px;
    transition: all 0.25s;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }

  .btn-start:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  /* ── PROGRESS BAR ── */
  .progreso-container {
    background: white;
    padding: 20px 24px;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    display: none;
  }

  .progreso-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .progreso-label { font-size: 0.85rem; color: var(--gris); font-weight: 500; }
  .progreso-pts { font-weight: 700; color: var(--verde); font-size: 1rem; }

  .barra {
    background: #E5E7EB;
    border-radius: 50px;
    height: 8px;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }

  .barra-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--verde), var(--verde-medio));
    border-radius: 50px;
    transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    width: 0%;
  }

  /* ── SECCIONES ── */
  .seccion {
    max-width: 860px;
    margin: 0 auto;
    padding: 60px 24px;
    display: none;
  }

  .seccion.activa { display: block; }

  .nivel-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 50px;
    padding: 6px 16px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .nivel-chip.n1 { background: #E8F5EE; color: var(--verde); }
  .nivel-chip.n2 { background: #FEF3CD; color: #B7791F; }
  .nivel-chip.n3 { background: #FEE2E2; color: var(--rojo); }
  .nivel-chip.n4 { background: #EEF2FF; color: var(--azul); }

  .seccion-titulo {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
    color: #1a1a2e;
  }

  .seccion-intro {
    font-size: 1.05rem;
    color: var(--gris);
    line-height: 1.8;
    margin-bottom: 36px;
    border-left: 3px solid var(--verde);
    padding-left: 16px;
  }

  /* ── CARDS ── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  .card {
    background: white;
    border-radius: var(--radio);
    padding: 24px;
    box-shadow: var(--sombra);
    border: 1px solid #F3F4F6;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover { transform: translateY(-3px); box-shadow: var(--sombra-fuerte); }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    display: block;
  }

  .card h3 {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 8px;
    color: #1a1a2e;
  }

  .card p {
    font-size: 0.9rem;
    color: var(--gris);
    line-height: 1.6;
  }

  /* ── ALERTA ── */
  .alerta {
    border-radius: var(--radio);
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .alerta.info { background: #EFF6FF; border-left: 4px solid #3B82F6; }
  .alerta.warn { background: #FFFBEB; border-left: 4px solid var(--amarillo); }
  .alerta.danger { background: #FEF2F2; border-left: 4px solid var(--rojo); }
  .alerta.exito { background: var(--verde-claro); border-left: 4px solid var(--verde); }

  .alerta-icon { font-size: 1.4rem; flex-shrink: 0; }
  .alerta-texto h4 { font-weight: 700; font-size: 0.95rem; margin-bottom: 4px; }
  .alerta-texto p { font-size: 0.88rem; color: var(--gris); line-height: 1.5; }

  /* ── QUIZ ── */
  .quiz-card {
    background: white;
    border-radius: var(--radio);
    padding: 32px;
    box-shadow: var(--sombra);
    margin-bottom: 24px;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .quiz-pregunta {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #1a1a2e;
    line-height: 1.4;
  }

  .quiz-opciones { display: flex; flex-direction: column; gap: 10px; }

  .opcion {
    border: 1.5px solid #E5E7EB;
    border-radius: var(--radio-sm);
    padding: 14px 18px;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.2s;
    background: white;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    color: #1a1a2e;
  }

  .opcion:hover { border-color: var(--verde); background: var(--verde-claro); }
  .opcion.correcta { border-color: var(--verde); background: var(--verde-claro); color: var(--verde); font-weight: 600; }
  .opcion.incorrecta { border-color: var(--rojo); background: #FEF2F2; color: var(--rojo); }
  .opcion.deshabilitada { pointer-events: none; opacity: 0.6; }

  .feedback-quiz {
    margin-top: 16px;
    padding: 14px 18px;
    border-radius: var(--radio-sm);
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
    line-height: 1.5;
  }

  .feedback-quiz.show { display: block; }
  .feedback-quiz.ok { background: var(--verde-claro); color: var(--verde); }
  .feedback-quiz.mal { background: #FEF2F2; color: var(--rojo); }

  /* ── SCENARIO ── */
  .scenario {
    background: white;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    margin-bottom: 24px;
  }

  .scenario-header {
    background: linear-gradient(90deg, var(--azul), #4A5BC4);
    color: white;
    padding: 20px 24px;
  }

  .scenario-header h3 { font-weight: 700; font-size: 1rem; margin-bottom: 4px; }
  .scenario-header p { font-size: 0.85rem; opacity: 0.8; }

  .scenario-body { padding: 24px; }

  .dialogo {
    background: #F9FAFB;
    border-radius: var(--radio-sm);
    padding: 16px;
    margin-bottom: 16px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #374151;
    font-style: italic;
    border-left: 3px solid #D1D5DB;
  }

  .dialogo strong { font-style: normal; color: var(--azul); }

  /* ── RECURSOS ── */
  .recurso-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: white;
    border-radius: var(--radio-sm);
    margin-bottom: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border: 1px solid #F3F4F6;
    transition: transform 0.2s;
  }

  .recurso-item:hover { transform: translateX(4px); }

  .recurso-icon-box {
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .recurso-icon-box.verde { background: var(--verde-claro); }
  .recurso-icon-box.azul { background: #EEF2FF; }
  .recurso-icon-box.rojo { background: #FEF2F2; }

  .recurso-txt h4 { font-weight: 700; font-size: 0.95rem; margin-bottom: 2px; }
  .recurso-txt p { font-size: 0.82rem; color: var(--gris); }

  /* ── BOTONES NAV ── */
  .nav-btns {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #E5E7EB;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn-prim {
    background: var(--verde);
    color: white;
    box-shadow: 0 4px 16px rgba(26,122,74,0.3);
  }

  .btn-prim:hover { background: #155a38; transform: translateY(-1px); }
  .btn-prim:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .btn-sec {
    background: transparent;
    color: var(--gris);
    border: 1.5px solid #D1D5DB;
  }

  .btn-sec:hover { border-color: var(--verde); color: var(--verde); background: var(--verde-claro); }

  /* ── GRADUACIÓN ── */
  #seccion-graduacion {
    text-align: center;
    padding: 60px 24px 80px;
    display: none;
  }

  #seccion-graduacion.activa { display: block; }

  .grad-confetti {
    font-size: 3rem;
    margin-bottom: 24px;
    display: block;
    animation: bounce 1s infinite alternate;
  }

  @keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-10px); }
  }

  .diploma {
    background: white;
    border-radius: 24px;
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 48px 40px;
    box-shadow: 0 16px 64px rgba(0,0,0,0.12);
    border: 3px solid var(--verde);
    position: relative;
    overflow: hidden;
  }

  .diploma::before, .diploma::after {
    content: '';
    position: absolute;
    width: 120px; height: 120px;
    border-radius: 50%;
    opacity: 0.06;
  }

  .diploma::before { background: var(--verde); top: -40px; left: -40px; }
  .diploma::after { background: var(--azul); bottom: -40px; right: -40px; }

  .diploma-sello {
    width: 80px; height: 80px;
    background: linear-gradient(135deg, var(--verde), #0A5C36);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    font-size: 2rem;
    box-shadow: 0 8px 24px rgba(26,122,74,0.4);
  }

  .diploma h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--gris);
    margin-bottom: 8px;
    font-weight: 400;
  }

  .diploma h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    color: #1a1a2e;
    font-weight: 900;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .diploma-subtitulo {
    font-size: 0.9rem;
    color: var(--gris);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .puntuacion-grande {
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--verde);
    font-family: 'Playfair Display', serif;
    line-height: 1;
    margin-bottom: 4px;
  }

  .puntuacion-label { font-size: 0.85rem; color: var(--gris); }

  .estrellas { font-size: 2rem; margin: 16px 0; }

  .logros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .logro {
    background: white;
    border-radius: var(--radio);
    padding: 20px 16px;
    text-align: center;
    box-shadow: var(--sombra);
    border: 1px solid #F3F4F6;
  }

  .logro-icon { font-size: 1.8rem; margin-bottom: 8px; display: block; }
  .logro h4 { font-size: 0.85rem; font-weight: 700; margin-bottom: 4px; color: #1a1a2e; }
  .logro p { font-size: 0.75rem; color: var(--gris); }

  .btn-compartir {
    background: linear-gradient(135deg, var(--azul), #4A5BC4);
    color: white;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 16px 40px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(44,62,122,0.35);
    transition: all 0.25s;
    display: inline-block;
    margin: 0 8px 12px;
  }

  .btn-compartir:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(44,62,122,0.45); }

  /* ── DIVIDER ── */
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 32px 0;
    color: var(--gris);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #E5E7EB;
  }

  /* ── TABLA SEÑALES ── */
  .tabla-senales {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 0.9rem;
  }

  .tabla-senales th {
    background: #F9FAFB;
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--gris);
    border-bottom: 2px solid #E5E7EB;
  }

  .tabla-senales td {
    padding: 12px 16px;
    border-bottom: 1px solid #F3F4F6;
    vertical-align: top;
  }

  .tabla-senales tr:last-child td { border-bottom: none; }

  .tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tag.leve { background: #D1FAE5; color: #065F46; }
  .tag.moderado { background: #FEF3C7; color: #92400E; }
  .tag.grave { background: #FEE2E2; color: #991B1B; }

  /* ── HERO SECTION LABEL ── */
  .hero-niveles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  /* ── MINI MAPA DE NIVELES ── */
  .mapa-niveles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    margin: 40px auto;
    max-width: 700px;
  }

  .nivel-nodo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .nivel-circulo {
    width: 60px; height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    border: 3px solid #E5E7EB;
    background: white;
    transition: all 0.2s;
    font-weight: 700;
  }

  .nivel-nodo.completado .nivel-circulo {
    border-color: var(--verde);
    background: var(--verde-claro);
  }

  .nivel-nodo.activo-nodo .nivel-circulo {
    border-color: var(--azul);
    background: #EEF2FF;
    box-shadow: 0 0 0 4px rgba(44,62,122,0.15);
  }

  .nivel-nodo span { font-size: 0.72rem; color: var(--gris); font-weight: 600; text-align: center; max-width: 70px; }

  .nivel-linea {
    flex: 1;
    height: 3px;
    background: #E5E7EB;
    min-width: 20px;
    max-width: 60px;
    transition: background 0.4s;
  }

  .nivel-linea.completada { background: var(--verde); }

  /* ── ACIERTOS COUNTER ── */
  .aciertos-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .acierto-stat {
    text-align: center;
    background: white;
    border-radius: var(--radio);
    padding: 16px 24px;
    box-shadow: var(--sombra);
    min-width: 100px;
  }

  .acierto-stat .num { font-size: 2rem; font-weight: 900; font-family: 'Playfair Display', serif; }
  .acierto-stat .etq { font-size: 0.75rem; color: var(--gris); text-transform: uppercase; letter-spacing: 0.5px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 600px) {
    .cards-grid { grid-template-columns: 1fr; }
    .logros-grid { grid-template-columns: 1fr 1fr; }
    .diploma { padding: 32px 24px; }
  }

  /* ── TOAST ── */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #1a1a2e;
    color: white;
    padding: 14px 20px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 9999;
    transform: translateY(80px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    max-width: 300px;
    box-shadow: var(--sombra-fuerte);
  }

  .toast.visible { transform: translateY(0); opacity: 1; }

  /* Animacion entrada secciones */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .seccion.activa { animation: fadeUp 0.4s ease; }

  .input-nombre {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    padding: 12px 18px;
    border: 1.5px solid #D1D5DB;
    border-radius: 50px;
    width: 100%;
    max-width: 360px;
    margin: 0 auto 16px;
    display: block;
    outline: none;
    transition: border-color 0.2s;
  }

  .input-nombre:focus { border-color: var(--verde); }
</style>
</head>
<body>

